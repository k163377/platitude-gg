{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook pre-write"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook pre-shell"
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook pre-worktree"
          }
        ]
      },
      {
        "matcher": "mcp__ccd_session__spawn_task",
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook pre-chip"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook pre-tool"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook permission-request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook post-tool"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook post-write"
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook post-worktree"
          }
        ]
      },
      {
        "matcher": "mcp__ccd_session__(spawn|dismiss)_task",
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook post-chip"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook post-tool"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook subagent-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook subagent-stop"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook permission-denied"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook stop"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook stop-failure"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook prompt-submit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook session-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook session-end"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook elicitation"
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.pgg-claude-hook=!.claude/hooks/runner.sh pgg-claude-hook elicitation-result"
          }
        ]
      }
    ]
  }
}
