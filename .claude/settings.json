{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook pre-write"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook pre-shell"
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook pre-worktree"
          }
        ]
      },
      {
        "matcher": "mcp__ccd_session__spawn_task",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook pre-chip"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook pre-tool"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook permission-request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook post-tool"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook post-write"
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook post-worktree"
          }
        ]
      },
      {
        "matcher": "mcp__ccd_session__(spawn|dismiss)_task",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook post-chip"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook post-tool"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook subagent-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook subagent-stop"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook permission-denied"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook stop"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook stop-failure"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook prompt-submit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook session-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook session-end"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook elicitation"
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p xtask --profile hooks -- hook elicitation-result"
          }
        ]
      }
    ]
  }
}
