---
source: crates/platitude-core/src/highlight/tree/tests.rs
description: "Each sample line (`|`) over the role of each of its characters: c comment, k keyword, t type, f function, s string, n constant, a annotation, blank plain."
---
| # A comment.
  cccccccccccc
| /* A block comment. */
  cccccccccccccccccccccc
| { pkgs ? import <nixpkgs> { }, lib, ... }:
           ffffff sssssssss
| 
| let
  kkk
|   name = "sample";
           ssssssss
|   version = "1.0";
              sssss
|   count = 42;
            nn
|   ratio = 1.5;
            nnn
|   enabled = true;
|   nothing = null;
|   path = ./src;
           sssss
|   greet = who: "hello, ${who}";
                 sssssssssssssss
|   multi = ''
            ss
|     indented ${name}
  ssssssssssssssssssss
|   '';
  ssss
| in
  kk
| rec {
  kkk
|   inherit name version;
    kkkkkkk
|   src = lib.cleanSource path;
|   out = if enabled then greet name else throw "no";
          kk         kkkk fffff      kkkk fffff ssss
|   list = [ 1 "two" ./three ];
             n sssss sssssss
|   merged = { a = 1; } // { b = 2; };
                   n             n
|   check = assert count > 0; with pkgs; hello;
            kkkkkk         n  kkkk
| }
