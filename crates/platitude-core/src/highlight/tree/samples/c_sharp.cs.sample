/// <summary>A doc comment.</summary>
using System;
using System.Collections.Generic;

namespace Demo.Sample;

[Serializable]
public sealed class Point<T> : IComparable<T> where T : struct
{
    public const int Origin = 0;
    private readonly double _x;
    public int Count { get; private set; } = 42;

    public Point(double x) => _x = x;

    public int CompareTo(T other) => 0;

    public async Task<string> DescribeAsync(int? limit = null)
    {
        var text = $"x = {_x}, limit = {limit}";
        var raw = @"C:\path";
        char c = 'c';
        bool ok = true && limit is not null;
        if (ok)
        {
            Console.WriteLine(text + raw + c);
        }
        else
        {
            throw new InvalidOperationException("no");
        }
        foreach (var item in new List<int> { 1, 2 })
        {
            continue;
        }
        try
        {
            await Task.Delay(1);
        }
        catch (Exception e) when (e is TimeoutException)
        {
        }
        finally
        {
        }
        switch (Count)
        {
            case 0:
                break;
            default:
                return nameof(Count);
        }
        return 0xFF.ToString() + 1.5e3;
    }
}

public enum Mode { Idle, Busy }

public record Person(string Name, int Age);

public static class Extensions
{
    extension(string s)
    {
        public int Twice => s.Length * 2;
    }
}
