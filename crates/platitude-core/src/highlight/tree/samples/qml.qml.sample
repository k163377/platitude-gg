// A line comment.
/* A block comment. */
import QtQuick
import QtQuick.Layouts
import "components" as Parts

Item {
    id: root
    objectName: "root"
    property int count: 0
    readonly property real ratio: 1.5
    property bool active: true
    property var model: null
    required property string label
    signal clicked(int x, int y)

    Layout.fillWidth: true
    Keys.onPressed: (event) => event.accepted = true
    Component.onCompleted: console.log("ready", count)

    function grow(by: int): int {
        if (by > 0) {
            return count + by;
        }
        for (let i = 0; i < 3; i++) {
            count += i;
        }
        return Math.max(0, count);
    }

    Rectangle {
        anchors.fill: parent
        color: root.active ? "#123456" : "transparent"
        onWidthChanged: root.grow(1)
    }

    states: State {
        name: "busy"
    }
}
