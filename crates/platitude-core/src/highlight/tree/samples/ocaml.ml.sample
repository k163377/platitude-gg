(* A comment. *)
(** A doc comment. *)
open Printf

module Point = struct
  type t = { x : int; mutable y : float }

  let origin = { x = 0; y = 1.5e3 }

  let shift ?(by = 1) p = { p with x = p.x + by }
end

type shape =
  | Circle of float
  | Square of int

exception Failed of string

let rec area = function
  | Circle r -> 3.14 *. r *. r
  | Square s -> float_of_int (s * 0xFF)

let () =
  let text = "text\n" and c = 'c' in
  let ok = true && not false in
  if ok then printf "%s %c\n" text c else raise (Failed "no");
  for i = 0 to 3 do ignore i done;
  while false do () done;
  match Point.shift Point.origin with
  | { x; _ } when x > 0 -> ()
  | _ -> ( try failwith "x" with Failure _ -> () )
