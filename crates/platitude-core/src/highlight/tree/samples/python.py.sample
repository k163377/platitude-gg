from __future__ import annotations
import os.path as osp

CONSTANT = 42


@dataclass(frozen=True)
class Point(Base):
    """A class docstring."""

    x: int = 0
    y: float = 1.5e3

    def __init__(self, x: int, *args, **kwargs) -> None:
        super().__init__()
        self.x = x

    @property
    def norm(self) -> float:
        return (self.x ** 2 + self.y ** 2) ** 0.5


