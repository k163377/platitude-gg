// A line comment.
/* A block comment. */
#include <stdio.h>
#include "local.h"
#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define LIMIT 10

#ifdef DEBUG
#endif

typedef struct point {
    int x;
    double y;
} point_t;

enum mode { IDLE, BUSY };

static const char *name = "sample";
extern volatile unsigned long count;

static inline int square(int v) { return v * v; }

int main(int argc, char **argv) {
    char c = 'c';
    float f = 1.5e3f;
    long n = 0xFFL + 42;
    point_t p = { .x = 1, .y = 2.0 };
    if (argc > 1 && argv != NULL) {
        printf("%s %d\n", name, square(p.x));
    } else {
        return -1;
    }
    for (int i = 0; i < LIMIT; i++) {
        continue;
    }
    while (0) {
        break;
    }
    switch (c) {
    case 'a':
        goto done;
    default:
        break;
    }
done:
    n = sizeof(point_t);
    return MAX(n, (long)f) ? true : false;
}
