---
source: crates/platitude-core/src/settings/store.rs
expression: settings.to_table().to_string()
---
version = 1

[[avatar]]
email = "ada@example.com"
file = "3f2a1c4e5b6d7089000004d2.png"
name = "Ada Lovelace"

[defaults]
auto_fetch_minutes = 5
git_concurrency = 8
git_path = "C:/tools/git/cmd/git.exe"
initial_commits = 4000
network_timeout_secs = 300
refresh_ceiling_secs = 20
refresh_floor_secs = 3
worktrees_ceiling_secs = 60
worktrees_floor_secs = 10
worktrees_interval_secs = 45
worktrees_reading = "fixed"
