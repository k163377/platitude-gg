# Desktop entry for the Linux packages. Install alongside the icons:
#
#   install -Dm644 platitude-gg.desktop \
#     "$PREFIX/share/applications/platitude-gg.desktop"
#   for s in 16 24 32 48 64 128 256; do
#     install -Dm644 "crates/platitude-app/assets/icon-$s.png" \
#       "$PREFIX/share/icons/hicolor/${s}x${s}/apps/platitude-gg.png"
#   done
#
# Icon= names the file without a path or extension: the shell resolves it
# through the hicolor theme, which is why the installed names must be
# platitude-gg.png and must match Icon= below.
#
# StartupWMClass has to equal the WM_CLASS the window actually carries, or
# the launcher shows a second, iconless entry once the app is running. The
# xcb plugin builds WM_CLASS out of Qt's application name, which is the
# slug (main.rs) -- these two move together.
[Desktop Entry]
Type=Application
Name=Platitude GG
GenericName=Git GUI
Comment=A thin, fast git GUI driving the system git CLI
Exec=platitude-gg
Icon=platitude-gg
StartupWMClass=platitude-gg
Terminal=false
Categories=Development;RevisionControl;
Keywords=git;vcs;version control;commit;branch;
