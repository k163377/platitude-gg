# Rust build artifacts (workspace root and spike/)
target/

# The shot board (cargo xtask shots), one beside this .git for every seat.
.shots/

# The benchmark repository (cargo xtask corpus), beside this .git so every
# seat measures one corpus; the next `corpus` regenerates it if deleted.
.pgg-perf-corpus/
.pgg-perf-corpus.partial-*/
# Its extra worktrees (cargo xtask corpus --worktrees).
.pgg-perf-corpus-worktree-*/

# Hook ledgers, one file per session, beside this .git so every seat's
# sessions share them: task chips (hook chips), recent shell lines (hook
# repeat), the seat entered (hook seat), the landing permit (hook permit).
.chips/
.repeats/
.entered/
.permits/
# The sleep holder's claims (cargo xtask awake), one file per session,
# beside this .git so every seat's sessions keep one holder.
.awake/

# IDE / editors
.idea/
*.iml
.vscode/

# Qt / QML tooling
.qmlls.ini

# insta pending snapshots (review-time only)
*.pending-snap

# Byproduct of running aqtinstall from the project directory
aqtinstall.log

# OS junk
Thumbs.db
Desktop.ini
.DS_Store
