# Rust build artifacts (workspace root and spike/)
target/

# The shot board (cargo xtask shots): pictures and the page over them.
# One board beside this .git for every seat, so it sits in the primary
# checkout and never in a worktree's own tree.
.shots/

# The benchmark repository (cargo xtask corpus): generated, never
# cloned, beside this .git so all six seats measure one corpus. A
# hundred thousand tracked files and their build output, so a checkout
# that does not ignore it reads as a hundred thousand untracked ones.
# Delete it and the next `corpus` builds the same one again.
.pgg-perf-corpus/
.pgg-perf-corpus.partial-*/

# The task-chip ledger (hook chips): one file per session, beside this
# .git so every seat's sessions write to one directory. Cleared when the
# session that wrote it ends.
.chips/

# IDE / editors
.idea/
*.iml
.vscode/

# Qt / QML tooling
.qmlls.ini

# insta snapshot tests (pending snapshots are review-time only)
*.pending-snap

# Byproduct of running aqtinstall from the project directory
aqtinstall.log

# OS junk
Thumbs.db
Desktop.ini
.DS_Store
